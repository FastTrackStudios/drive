<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- A File Provider extension is always sandboxed: the system will not
         load one that is not. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Drive.app's group (the registrar's domain work). -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>28C2G63DA7.app.fasttrackstudio.drive</string>
    </array>
    <!-- The agent's folder: its app socket, and where fetched bytes and
         outgoing edits are staged. macOS 15 refuses the app group's
         container to the agent (TCC's App Data protection), so the
         extension comes to the agent instead. A temporary exception, which
         a Developer ID build may carry (no App Store build is planned). -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
    <array>
        <string>/.local/share/drive-agent/</string>
    </array>
</dict>
</plist>
